{
  "info": {
    "name": "EcoCycle Backend - Semana 1 (Auth)",
    "description": "Endpoints de Usuario e Autenticacao (JWT) do back-end do EcoCycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"apelido\": \"maria_eco\",\n  \"senha\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@example.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        },
        {
          "name": "Update Avatar",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avatar\": \"AVATAR_05\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/me/avatar", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me","avatar"] }
          }
        },
        {
          "name": "Deactivate Account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/users/me", "host": ["{{baseUrl}}"], "path": ["api","v1","users","me"] }
          }
        }
      ]
    },
    {
      "name": "Trilhas & Conteúdo",
      "item": [
        {
          "name": "Listar Trilhas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/trilhas", "host": ["{{baseUrl}}"], "path": ["api","v1","trilhas"] }
          }
        },
        {
          "name": "Detalhe do Conteúdo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/conteudos/1", "host": ["{{baseUrl}}"], "path": ["api","v1","conteudos","1"] }
          }
        },
        {
          "name": "Marcar Conteúdo como Lido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/conteudos/1/marcar-lido", "host": ["{{baseUrl}}"], "path": ["api","v1","conteudos","1","marcar-lido"] }
          }
        }
      ]
    },
    {
      "name": "Quizzes",
      "item": [
        {
          "name": "Buscar Quiz por Conteúdo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/quizzes/por-conteudo/1", "host": ["{{baseUrl}}"], "path": ["api","v1","quizzes","por-conteudo","1"] }
          }
        },
        {
          "name": "Submeter Respostas",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respostas\": [\n    { \"perguntaId\": 1, \"alternativaId\": 2 },\n    { \"perguntaId\": 2, \"alternativaId\": 7 },\n    { \"perguntaId\": 3, \"alternativaId\": 10 },\n    { \"perguntaId\": 4, \"alternativaId\": 15 },\n    { \"perguntaId\": 5, \"alternativaId\": 18 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/quizzes/1/submeter", "host": ["{{baseUrl}}"], "path": ["api","v1","quizzes","1","submeter"] }
          }
        }
      ]
    },
    {
      "name": "Figurinhas",
      "item": [
        {
          "name": "Listar Álbum",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/figurinhas", "host": ["{{baseUrl}}"], "path": ["api","v1","figurinhas"] }
          }
        },
        {
          "name": "Detalhe da Figurinha",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/figurinhas/1", "host": ["{{baseUrl}}"], "path": ["api","v1","figurinhas","1"] }
          }
        }
      ]
    },
    {
      "name": "Progresso",
      "item": [
        {
          "name": "Meu Progresso",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/progresso/me", "host": ["{{baseUrl}}"], "path": ["api","v1","progresso","me"] }
          }
        }
      ]
    },
    {
      "name": "Pontos de Coleta",
      "item": [
        {
          "name": "Listar Todos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/pontos-coleta", "host": ["{{baseUrl}}"], "path": ["api","v1","pontos-coleta"] }
          }
        },
        {
          "name": "Buscar Proximos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pontos-coleta?lat=-23.5433&lng=-46.6528&raioKm=5",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","pontos-coleta"],
              "query": [
                { "key": "lat", "value": "-23.5433" },
                { "key": "lng", "value": "-46.6528" },
                { "key": "raioKm", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Detalhe do Ponto",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/v1/pontos-coleta/1", "host": ["{{baseUrl}}"], "path": ["api","v1","pontos-coleta","1"] }
          }
        }
      ]
    },
    {
      "name": "Scanner",
      "item": [
        {
          "name": "Reconhecer Componente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificadorComponente\": \"MOUSE\",\n  \"confianca\": 87.5\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/scanner/reconhecer", "host": ["{{baseUrl}}"], "path": ["api","v1","scanner","reconhecer"] }
          }
        }
      ]
    }
  ]
}
