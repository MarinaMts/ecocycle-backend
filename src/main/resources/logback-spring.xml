<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Registra as conversoes %clr/%wex usadas no padrao colorido de dev (nao vem por padrao no Logback puro) -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!--
        Producao: uma linha JSON por evento (LogstashEncoder), enxuta para ser lida
        direto no painel do Render e ainda pronta para um agregador de log.
        Campos: @timestamp, level, logger_name (so a classe), message, requestId,
        userId e, em erros, stack_trace.
    -->
    <springProfile name="prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <timeZone>America/Sao_Paulo</timeZone>
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
                <shortenedLoggerNameLength>0</shortenedLoggerNameLength>
                <includeContext>false</includeContext>
                <fieldNames>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                    <thread>[ignore]</thread>
                </fieldNames>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

    <!--
        Dev/test: texto legivel e colorido no console, com o MDC (requestId,
        userId) visivel ao lado da mensagem, para manter paridade
        com o que aparece no JSON de producao.
    -->
    <springProfile name="!prod">
        <appender name="CONSOLE_PLAIN" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level) %clr([%thread]){faint} %clr(%logger{36}){cyan} - %msg %mdc%n%ex</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_PLAIN"/>
        </root>
    </springProfile>

</configuration>
